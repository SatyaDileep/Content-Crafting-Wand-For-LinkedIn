# AI keys are entered by users inside the app (Settings → AI Provider) and stored in localStorage only.
# Supported providers: Gemini, Groq, or any OpenAI-compatible endpoint. No env var needed.
VITE_LINKEDIN_CLIENT_ID=your-linkedin-client-id.apps.linkedin.com
VITE_TELEMETRY_URL=/api/telemetry
VITE_TELEMETRY_ENABLED=1
# Server (Vercel/Netlify) — set as env vars in dashboard, NOT VITE_:
# LINKEDIN_CLIENT_ID=...
# LINKEDIN_CLIENT_SECRET=...
